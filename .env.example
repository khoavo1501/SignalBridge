# Sao chép thành .env (không commit). Value là ví dụ — secrets phải tự sinh.
# Postgres
POSTGRES_DB=signalbridge
POSTGRES_USER=sb
POSTGRES_PASSWORD=change-me

# InfluxDB 2.x (init once qua docker volume)
INFLUX_USER=sb-admin
INFLUX_PASSWORD=change-me-too
INFLUX_ORG=signalbridge
INFLUX_BUCKET=plc
INFLUX_TOKEN=change-me-token

# EMQX dashboard (port 18083)
EMQX_DASHBOARD_PASSWORD=change-me

# Backend
DATABASE_URL=postgresql+asyncpg://sb:change-me@postgres:5432/signalbridge
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=change-me-token
INFLUX_ORG=signalbridge
INFLUX_BUCKET=plc
REDIS_URL=redis://redis:6379/0
MQTT_HOST=emqx
MQTT_PORT=1883
MQTT_TOPIC_FILTER=devices/+/+
STALE_THRESHOLD_S=10
WS_TELEMETRY_MIN_INTERVAL_MS=250
# Bật fan-out WS qua Redis Pub/Sub khi chạy nhiều backend instance (§4.2, trigger §1.2)
WS_PUBSUB_ENABLED=false
AUTH_ENABLED=false

# Gateway simulator (dev/test)
SIM_MQTT_HOST=localhost
SIM_MQTT_PORT=1883
SIM_GATEWAY_ID=GW_S7200_01
SIM_INTERVAL_MS=100
